{
  "name": "metacodex-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-provider coding agent CLI. Session router on the Pi SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorbenazzi/metacodex-cli.git"
  },
  "homepage": "https://github.com/victorbenazzi/metacodex-cli#readme",
  "bugs": {
    "url": "https://github.com/victorbenazzi/metacodex-cli/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "bin": {
    "mcx": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "jiti": "2.7.0",
    "pi-mcp-adapter": "2.29.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
